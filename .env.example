# ---- LLM (OpenAI 兼容接口, 也可填 DeepSeek/通义/vLLM/Ollama 等兼容端点) ----
LLM_API_KEY=sk-your-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_ASYNC=4
LLM_TIMEOUT=240
# LLM_TEMPERATURE=   # 缺省不传该参数; 注意 Kimi 系列模型仅允许 temperature=1
ENABLE_LLM_CACHE=true

# ---- Embedding (缺省复用 LLM 的 key/endpoint) ----
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
EMBEDDING_DIM=1536

# ---- Rerank (可选, 不配则不启用; 失败自动回退原始排序) ----
# Jina/Cohere 风格: POST {RERANK_BASE_URL}/rerank
# RERANK_MODEL=jina-reranker-v2-base-en
# RERANK_BASE_URL=https://api.jina.ai/v1
# 阿里云百炼 DashScope 原生 (按 base_url 自动识别):
# RERANK_MODEL=gte-rerank-v2
# RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# RERANK_API_KEY=        # 缺省复用 LLM_API_KEY
# RERANK_TOP_N=20
# MIN_RERANK_SCORE=0.0
# RERANK_TIMEOUT=60

# ---- 切分 ----
CHUNK_TOKEN_SIZE=1200
CHUNK_OVERLAP_TOKEN_SIZE=100

# ---- 抽取 ----
MAX_GLEANING=1
SUMMARY_LANGUAGE=Chinese

# ---- 检索 ----
TOP_K=40
CHUNK_TOP_K=20
MAX_TOTAL_TOKENS=30000
COSINE_THRESHOLD=0.2

# ---- 会话 ----
MAX_HISTORY_MESSAGES=20

# ---- 删除 ----
# 删除文档时, 用 LLM 缓存重建存活实体/关系的描述 (清除被删文档的语义残留)
DELETE_REBUILD_DESCRIPTIONS=true

# ---- 服务 ----
HOST=0.0.0.0
PORT=8000
WORKING_DIR=./fusionrag_workspace

# ---- 存储后端 ----
# 总兜底: json(默认, 零外部依赖: 本地 JSON + numpy + NetworkX)
STORAGE_BACKEND=json
# 每类存储可独立指定后端, 优先级 <类>_BACKEND > STORAGE_BACKEND > json:
#   KV_BACKEND     : json / sqlite  (sqlite=标准库, 增量落盘消除写放大, 零外部服务)
#   VECTOR_BACKEND : json           (后续可扩展 sqlite-vec 等)
#   GRAPH_BACKEND  : json           (后续可扩展)
# KV_BACKEND=sqlite
# VECTOR_BACKEND=json
# GRAPH_BACKEND=json
